# Copy to .env and fill in. Never commit the real .env.
# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.stairwisemove.com,localhost,127.0.0.1

# Front-end origins allowed to POST to the API (comma separated)
CORS_ALLOWED_ORIGINS=https://stairwisemove.com,https://www.stairwisemove.com,http://localhost:8765

# Secret dashboard: visit /dashboard/<this-token>/ to see leads on your phone.
SECRET_DASHBOARD_TOKEN=change-me-to-a-long-random-token

# Notifications (all optional). Set what you have.
# Discord webhook pushes a message to your phone instantly (free).
DISCORD_WEBHOOK_URL=
# Email notifications (SMTP). Leave EMAIL_HOST blank to disable.
ADMIN_EMAIL=you@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Stairwise <noreply@stairwisemove.com>
